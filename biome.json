{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "e2e/**",
      "*.json",
      "*.ts",
      "*.mjs",
      "!package-lock.json",
      "!components.json",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      },
      "includes": ["src/components/ui/slider.tsx", "src/features/editor/landmark-canvas.tsx"]
    },
    {
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      },
      "includes": [
        "src/features/characters/create-character.tsx",
        "src/features/characters/library.tsx"
      ]
    }
  ]
}
